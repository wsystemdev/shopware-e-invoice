<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>E-invoices (XRechnung / EN 16931)</title>
        <title lang="de-DE">E-Rechnungen (XRechnung / EN 16931)</title>
        <input-field type="password">
            <name>apiKey</name>
            <label>W System API key (optional)</label>
            <label lang="de-DE">W System API-Schlüssel (optional)</label>
            <helpText>Without a key the free tier applies (20 API calls per day per server IP). Order data is sent to api.wsystem.dev to build and check the e-invoice. Get a free key (no card) at https://api.wsystem.dev/account/free-key?ref=shopware-einvoice</helpText>
            <helpText lang="de-DE">Ohne Schlüssel gilt die kostenlose Stufe (20 API-Aufrufe pro Tag und Server-IP). Bestelldaten werden zur Erstellung und Prüfung an api.wsystem.dev gesendet. Kostenloser Schlüssel (ohne Karte): https://api.wsystem.dev/account/free-key?ref=shopware-einvoice</helpText>
        </input-field>
        <input-field type="single-select">
            <name>format</name>
            <label>Format</label>
            <label lang="de-DE">Format</label>
            <defaultValue>xrechnung</defaultValue>
            <options>
                <option><id>xrechnung</id><name>XRechnung 3.0 (UBL), Germany</name><name lang="de-DE">XRechnung 3.0 (UBL), Deutschland</name></option>
                <option><id>en16931</id><name>EN 16931 (UBL), EU standard</name><name lang="de-DE">EN 16931 (UBL), EU-Standard</name></option>
                <option><id>peppol-bis3</id><name>Peppol BIS Billing 3.0 (UBL)</name><name lang="de-DE">Peppol BIS Billing 3.0 (UBL)</name></option>
            </options>
        </input-field>
        <input-field type="single-select">
            <name>trigger</name>
            <label>Create automatically</label>
            <label lang="de-DE">Automatisch erstellen</label>
            <defaultValue>completed</defaultValue>
            <options>
                <option><id>completed</id><name>When the order is completed</name><name lang="de-DE">Wenn die Bestellung abgeschlossen ist</name></option>
                <option><id>paid</id><name>When the order is paid</name><name lang="de-DE">Wenn die Bestellung bezahlt ist</name></option>
                <option><id>placed</id><name>When the order is placed</name><name lang="de-DE">Wenn die Bestellung aufgegeben wird</name></option>
                <option><id>off</id><name>Never (manual only, from the order)</name><name lang="de-DE">Nie (nur manuell an der Bestellung)</name></option>
            </options>
        </input-field>
        <input-field type="bool">
            <name>onlyB2b</name>
            <label>Only for business customers</label>
            <label lang="de-DE">Nur für Geschäftskunden</label>
            <helpText>Skips orders without a company name and without a VAT ID.</helpText>
            <helpText lang="de-DE">Überspringt Bestellungen ohne Firmennamen und ohne USt-IdNr.</helpText>
        </input-field>
        <input-field type="bool">
            <name>attachEmail</name>
            <label>Attach the XML to order emails</label>
            <label lang="de-DE">XML an Bestell-E-Mails anhängen</label>
            <helpText>Only attached when the e-invoice passed validation.</helpText>
            <helpText lang="de-DE">Wird nur angehängt, wenn die E-Rechnung die Prüfung bestanden hat.</helpText>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="bool">
            <name>attachOrderConfirmation</name>
            <label>Attach to: order confirmation</label>
            <label lang="de-DE">Anhängen an: Bestellbestätigung</label>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="bool">
            <name>attachCompleted</name>
            <label>Attach to: order completed</label>
            <label lang="de-DE">Anhängen an: Bestellung abgeschlossen</label>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="bool">
            <name>attachPaid</name>
            <label>Attach to: payment received</label>
            <label lang="de-DE">Anhängen an: Zahlung eingegangen</label>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="bool">
            <name>attachShipped</name>
            <label>Attach to: order shipped</label>
            <label lang="de-DE">Anhängen an: Bestellung versendet</label>
            <defaultValue>false</defaultValue>
        </input-field>
    </card>
    <card>
        <title>Your company (seller)</title>
        <title lang="de-DE">Ihr Unternehmen (Verkäufer)</title>
        <input-field>
            <name>sellerName</name>
            <label>Company name</label>
            <label lang="de-DE">Firmenname</label>
        </input-field>
        <input-field>
            <name>sellerStreet</name>
            <label>Street and number</label>
            <label lang="de-DE">Straße und Hausnummer</label>
        </input-field>
        <input-field>
            <name>sellerPostcode</name>
            <label>Postcode</label>
            <label lang="de-DE">PLZ</label>
        </input-field>
        <input-field>
            <name>sellerCity</name>
            <label>City</label>
            <label lang="de-DE">Ort</label>
        </input-field>
        <input-field>
            <name>sellerCountry</name>
            <label>Country (2-letter code)</label>
            <label lang="de-DE">Land (2-Buchstaben-Code)</label>
            <defaultValue>DE</defaultValue>
        </input-field>
        <input-field>
            <name>sellerVatId</name>
            <label>VAT ID</label>
            <label lang="de-DE">USt-IdNr.</label>
            <helpText>e.g. DE123456789. Without a VAT ID enter the tax number below.</helpText>
            <helpText lang="de-DE">z. B. DE123456789. Ohne USt-IdNr. unten die Steuernummer eintragen.</helpText>
        </input-field>
        <input-field>
            <name>sellerTaxNo</name>
            <label>Tax number</label>
            <label lang="de-DE">Steuernummer</label>
        </input-field>
        <input-field>
            <name>sellerRegNo</name>
            <label>Commercial register number</label>
            <label lang="de-DE">Handelsregisternummer</label>
        </input-field>
        <input-field type="bool">
            <name>smallBusiness</name>
            <label>Small business scheme (section 19 UStG)</label>
            <label lang="de-DE">Kleinunternehmerregelung (§ 19 UStG)</label>
        </input-field>
        <input-field>
            <name>sellerContact</name>
            <label>Contact person</label>
            <label lang="de-DE">Ansprechpartner</label>
            <helpText>XRechnung requires contact name, phone and email.</helpText>
            <helpText lang="de-DE">XRechnung verlangt Ansprechpartner, Telefon und E-Mail.</helpText>
        </input-field>
        <input-field>
            <name>sellerPhone</name>
            <label>Phone</label>
            <label lang="de-DE">Telefon</label>
        </input-field>
        <input-field>
            <name>sellerEmail</name>
            <label>Email</label>
            <label lang="de-DE">E-Mail</label>
        </input-field>
        <input-field>
            <name>sellerIban</name>
            <label>IBAN (for bank transfer)</label>
            <label lang="de-DE">IBAN (für Überweisung)</label>
        </input-field>
        <input-field>
            <name>sellerBic</name>
            <label>BIC</label>
            <label lang="de-DE">BIC</label>
        </input-field>
        <input-field>
            <name>paymentTerms</name>
            <label>Payment terms (text)</label>
            <label lang="de-DE">Zahlungsbedingungen (Text)</label>
            <helpText>e.g. Payable within 14 days without deduction.</helpText>
            <helpText lang="de-DE">z. B. Zahlbar innerhalb von 14 Tagen ohne Abzug.</helpText>
        </input-field>
    </card>
</config>
