<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="WSystem\EInvoice\Service\CurlTransport"/>
        <service id="WSystem\EInvoice\Service\ApiClient">
            <argument type="service" id="WSystem\EInvoice\Service\CurlTransport"/>
        </service>
        <service id="WSystem\EInvoice\Service\InvoiceService" public="true">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="WSystem\EInvoice\Service\ApiClient"/>
            <argument type="service" id="logger"/>
        </service>
        <service id="WSystem\EInvoice\Subscriber\AutoCreateSubscriber">
            <argument type="service" id="WSystem\EInvoice\Service\InvoiceService"/>
            <argument type="service" id="order_transaction.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="WSystem\EInvoice\Subscriber\MailAttachSubscriber">
            <argument type="service" id="WSystem\EInvoice\Service\InvoiceService"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="WSystem\EInvoice\Controller\InvoiceController" public="true">
            <argument type="service" id="WSystem\EInvoice\Service\InvoiceService"/>
        </service>
        <service id="WSystem\EInvoice\Command\GenerateCommand">
            <argument type="service" id="WSystem\EInvoice\Service\InvoiceService"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
